---
// Ilustração própria de uma caçamba estacionária (formato trapézio usado no Brasil)
interface Props { class?: string; titulo?: string }
const { class: classe, titulo = 'Ilustração de uma caçamba de entulho laranja cheia de tijolos e telhas' } = Astro.props;
---
<svg class={classe} viewBox="0 0 440 300" role="img" aria-label={titulo} xmlns="http://www.w3.org/2000/svg">
  <ellipse cx="220" cy="268" rx="190" ry="14" fill="#000" opacity=".25"/>
  <!-- entulho -->
  <g>
    <rect x="96" y="70" width="44" height="22" rx="2" fill="#b65a3a" transform="rotate(-12 118 81)"/>
    <rect x="140" y="58" width="50" height="24" rx="2" fill="#c96a45" transform="rotate(8 165 70)"/>
    <rect x="198" y="64" width="38" height="20" rx="2" fill="#9aa5b1" transform="rotate(-6 217 74)"/>
    <rect x="240" y="54" width="52" height="24" rx="2" fill="#b65a3a" transform="rotate(14 266 66)"/>
    <rect x="290" y="72" width="46" height="20" rx="2" fill="#cbd2d9" transform="rotate(-10 313 82)"/>
    <path d="M170 86 l40 -30 l30 34 z" fill="#7b8794"/>
    <rect x="120" y="88" width="210" height="16" fill="#8d6e5a"/>
  </g>
  <!-- corpo da caçamba -->
  <path d="M70 96 H370 L340 246 H100 Z" fill="#e8590c"/>
  <path d="M70 96 H370 L366 116 H74 Z" fill="#b8460a"/>
  <!-- nervuras -->
  <g stroke="#b8460a" stroke-width="6" stroke-linecap="round">
    <line x1="140" y1="122" x2="148" y2="240"/>
    <line x1="220" y1="122" x2="220" y2="240"/>
    <line x1="300" y1="122" x2="292" y2="240"/>
  </g>
  <!-- faixas reflexivas -->
  <g>
    <rect x="86" y="200" width="44" height="12" fill="#fff"/>
    <rect x="86" y="200" width="22" height="12" fill="#e12d39"/>
    <rect x="310" y="200" width="44" height="12" fill="#fff"/>
    <rect x="332" y="200" width="22" height="12" fill="#e12d39"/>
  </g>
  <!-- olhais -->
  <circle cx="84" cy="120" r="9" fill="none" stroke="#1f2933" stroke-width="6"/>
  <circle cx="356" cy="120" r="9" fill="none" stroke="#1f2933" stroke-width="6"/>
  <!-- base -->
  <rect x="96" y="244" width="248" height="14" rx="3" fill="#323f4b"/>
</svg>
