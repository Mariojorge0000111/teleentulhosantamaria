---
// Ilustração própria de uma caçamba estacionária (formato trapézio usado no Brasil)
interface Props { class?: string; titulo?: string }
const { class: classe, titulo = 'Ilustração de uma caçamba de entulho laranja com tijolos' } = Astro.props;
---
<svg class={classe} viewBox="0 0 400 300" role="img" aria-label={titulo} xmlns="http://www.w3.org/2000/svg">
  <ellipse cx="200" cy="262" rx="160" ry="10" fill="#111827" opacity=".08"/>
  <rect x="112" y="78" width="54" height="26" rx="4" fill="#d6d3d1" transform="rotate(-10 139 91)"/>
  <rect x="170" y="66" width="60" height="28" rx="4" fill="#111827" transform="rotate(6 200 80)"/>
  <rect x="236" y="74" width="50" height="26" rx="4" fill="#a8a29e" transform="rotate(12 261 87)"/>
  <path d="M60 104 H340 L310 244 H90 Z" fill="#ea580c"/>
  <path d="M60 104 H340 L336 122 H64 Z" fill="#c2410c"/>
  <g stroke="#c2410c" stroke-width="5" stroke-linecap="round" opacity=".7">
    <line x1="140" y1="134" x2="147" y2="230"/>
    <line x1="200" y1="134" x2="200" y2="230"/>
    <line x1="260" y1="134" x2="253" y2="230"/>
  </g>
  <rect x="84" y="206" width="36" height="9" rx="2" fill="#fff"/>
  <rect x="280" y="206" width="36" height="9" rx="2" fill="#fff"/>
  <rect x="88" y="244" width="224" height="10" rx="5" fill="#111827"/>
</svg>
