---
// Google Analytics 4: propriedade "teleentulhosantamaria.com.br" (conta Sites SVG, p565106086).
// Evento principal: clique_whatsapp, disparado em todo link para wa.me.
// Parâmetros: area (topo, menu, capa, cta, barra_fixa, rodape, conteudo), texto_link, pagina, tipo_pagina.
const ID = 'G-94MBZR8DC5';
---
<script is:inline define:vars={{ ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', ID);

  // Carrega a tag depois que a página termina de carregar, para não pesar no desempenho.
  function carregarGA() {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
    document.head.appendChild(s);
  }
  if (document.readyState === 'complete') carregarGA();
  else window.addEventListener('load', function () { setTimeout(carregarGA, 0); });

  function tipoPagina(p) {
    if (p === '/') return 'home';
    var m = p.match(/^\/(servicos|bairros|cidades|blog|contato|perguntas-frequentes)\//);
    if (!m) return 'outra';
    if (m[1] === 'blog') return p.indexOf('/blog/categoria/') === 0 ? 'blog_categoria' : (p === '/blog/' ? 'blog_inicio' : 'artigo');
    return m[1];
  }

  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!el) return;
    var href = el.getAttribute('href') || '';
    if (!/wa\.me|api\.whatsapp\.com|whatsapp:\/\//.test(href)) return;
    var area = el.classList.contains('whats') ? 'barra_fixa'
      : el.closest('.gaveta') ? 'menu'
      : el.closest('header') ? 'topo'
      : el.closest('.hero') ? 'capa'
      : el.closest('.cta') ? 'cta'
      : el.closest('footer') ? 'rodape'
      : 'conteudo';
    gtag('event', 'clique_whatsapp', {
      area: area,
      texto_link: (el.textContent || el.getAttribute('aria-label') || '').replace(/\s+/g, ' ').trim().slice(0, 100),
      pagina: location.pathname,
      tipo_pagina: tipoPagina(location.pathname),
      transport_type: 'beacon'
    });
  }, true);
</script>
