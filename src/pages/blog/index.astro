---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Cta from '../../components/Cta.astro';
import Migalhas from '../../components/Migalhas.astro';
import { SILOS, todosPosts } from '../../data/silos';
const posts = todosPosts();
const migalhas = [{ nome: 'Blog' }];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Tele Entulho Santa Maria',
  url: new URL('/blog/', Astro.site).href,
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.titulo, url: new URL(p.url, Astro.site).href, datePublished: p.data })),
};
---
<Base
  title="Blog: Guias sobre Caçamba e Entulho em Santa Maria"
  description="Guias práticos sobre caçamba de entulho em Santa Maria RS: quanto custa, o que pode colocar, tamanhos, regras da prefeitura para caçamba na rua e descarte."
  schema={schema}
  migalhas={migalhas}
>
  <header class="pagina-topo">
    <div class="wrap">
      <Migalhas itens={migalhas} />
      <h1>Guias sobre caçamba e entulho</h1>
      <p class="lead">O que saber antes de pedir caçamba em Santa Maria, organizado por tema.</p>
      <ul class="chips" style="margin-top:1.5rem">{SILOS.map((s) => <li><a href={`/blog/categoria/${s.slug}/`}>{s.nome}</a></li>)}</ul>
    </div>
  </header>
  <section class="secao">
    <div class="wrap">
      {SILOS.map((s) => {
        const lista = posts.filter((p) => p.silo === s.slug);
        return (
          <div class="silo-bloco">
            <div class="cabeca">
              <div>
                <h2>{s.nome}</h2>
                <p>{s.intro}</p>
              </div>
              <a class="link-seta" href={`/blog/categoria/${s.slug}/`}>Ver categoria</a>
            </div>
            <div class="grade grade-3 trilho">
              {lista.slice(0, 3).map((p) => (
                <article class="card card-img card-link">
                  <Img nome={p.imagem} alt={p.imagemAlt} sizes="(max-width: 600px) 82vw, (max-width: 960px) 50vw, 360px" />
                  <div class="card-corpo">
                    <h3><a href={p.url}>{p.titulo}</a></h3>
                    <p>{p.descricao}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
  <Cta />
</Base>
