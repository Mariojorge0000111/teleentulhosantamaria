---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import CacambaArte from '../components/CacambaArte.astro';
import MapaAtendimento from '../components/MapaAtendimento.astro';
import IconeWhats from '../components/IconeWhats.astro';
import { SITE, linkWhatsapp, FONTES } from '../config';
import { SERVICOS } from '../data/servicos';
import { BAIRROS, CIDADES } from '../data/locais';
import { FAQ_HOME } from '../data/faq';

const posts = Object.values(import.meta.glob<any>('./blog/*.md', { eager: true }))
  .map((p) => ({ url: p.url, ...p.frontmatter }))
  .sort((a, b) => (a.data < b.data ? 1 : -1))
  .slice(0, 3);

const base = new URL('/', Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${base}#servico`,
    name: 'Tele entulho e caçamba de entulho em Santa Maria',
    serviceType: 'Aluguel de caçamba de entulho',
    provider: { '@id': `${base}#organizacao` },
    areaServed: [
      { '@type': 'City', name: 'Santa Maria' },
      ...CIDADES.map((c) => ({ '@type': 'City', name: c.nome })),
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Serviços',
      itemListElement: SERVICOS.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.nome, url: new URL(`/servicos/${s.slug}/`, Astro.site).href },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_HOME.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  },
];

const passos = [
  { t: 'Chame no WhatsApp', d: 'Diga o endereço, o bairro e o que vai descartar. Foto do entulho ajuda.' },
  { t: 'Receba o orçamento', d: 'Tamanho indicado, valor, prazo de entrega e dias de permanência, antes de fechar.' },
  { t: 'A caçamba chega', d: 'Entregue no ponto combinado: dentro do terreno ou junto ao meio-fio.' },
  { t: 'Retirada ou troca', d: 'Encheu? Avise. A caçamba sai e o entulho vai para área licenciada.' },
];

const tamanhos = [
  { m: 3, uso: 'Banheiro, cozinha, muro pequeno, limpeza de pátio', carrinhos: 50, h: 36 },
  { m: 4, uso: 'Reforma de vários cômodos, troca de piso da casa', carrinhos: 65, h: 46 },
  { m: 5, uso: 'Demolição, telhado e obra nova. Máximo em Santa Maria', carrinhos: 80, h: 56 },
];
const wa = linkWhatsapp();
---
<Base
  title="Tele Entulho em Santa Maria RS | Caçamba de Entulho"
  description="Tele entulho em Santa Maria RS: aluguel de caçamba de entulho de 3 a 5 m³ para obra, reforma e limpeza, com descarte licenciado. Orçamento no WhatsApp."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-grade">
      <div>
        <p class="sobretitulo">Tele entulho · Santa Maria, RS</p>
        <h1>Caçamba de entulho em Santa Maria, <em>sem complicação</em></h1>
        <p class="lead">Tele entulho para reforma, construção e limpeza de terreno. Mande o endereço pelo WhatsApp, receba tamanho, valor e prazo, e o entulho sai da obra para uma área licenciada.</p>
        <div class="botoes">
          <a class="btn btn-whats" href={wa} target="_blank" rel="noopener" data-evento="whatsapp"><IconeWhats />Pedir caçamba no WhatsApp</a>
          <a class="btn btn-claro" href="/servicos/tamanhos-de-cacamba/">Ver tamanhos</a>
        </div>
        <ul class="selos">
          <li>3 a 5 m³</li>
          <li>Destino licenciado</li>
          <li>Orçamento sem compromisso</li>
        </ul>
      </div>
      <div class="hero-arte"><CacambaArte /></div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <p class="sobretitulo">Como funciona</p>
          <h2>Do pedido à retirada</h2>
        </div>
      </div>
      <ol class="passos">
        {passos.map((p) => (
          <li>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <p class="sobretitulo">Serviços</p>
          <h2>Tele entulho para cada tipo de obra</h2>
          <p>Sem alugar caminhão nem procurar onde descartar. A caçamba fica na obra, você enche no seu ritmo e agenda a retirada pelo WhatsApp.</p>
        </div>
        <a class="link-seta" href="/servicos/">Todos os serviços</a>
      </div>
      <div class="grade grade-4 trilho">
        {SERVICOS.map((s) => (
          <article class="card card-img card-link">
            <Img nome={s.imagem} alt={s.imagemAlt} sizes="(max-width: 600px) 82vw, (max-width: 960px) 50vw, 270px" />
            <div class="card-corpo">
              <h3><a href={`/servicos/${s.slug}/`}>{s.nome}</a></h3>
              <p>{s.curto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <p class="sobretitulo">Tamanhos</p>
          <h2>Qual caçamba pedir</h2>
          <p>Um carrinho de mão de obra leva uns 60 litros. Conte os carrinhos de entulho e compare. Em Santa Maria, o máximo permitido é 5 m³.</p>
        </div>
        <a class="link-seta" href="/servicos/tamanhos-de-cacamba/">Guia de tamanhos</a>
      </div>
      <div class="tamanhos">
        {tamanhos.map((t) => (
          <div class={`tamanho${t.m === 4 ? ' tamanho-destaque' : ''}`}>
            <div class="m3">{t.m}<small>m³</small></div>
            <svg width="120" height="56" viewBox="0 0 150 70" aria-hidden="true">
              <path d={`M10 ${70 - t.h} H140 L128 64 H22 Z`} fill="#ea580c" />
              <rect x="22" y="64" width="106" height="6" rx="3" fill={t.m === 4 ? '#ffffff' : '#111827'} />
            </svg>
            <strong>Cerca de {t.carrinhos} carrinhos de mão</strong>
            <p class="uso">{t.uso}.</p>
            <a class="link-seta" href={linkWhatsapp(`Olá! Vim pelo site e quero orçamento de caçamba de ${t.m} m³ em Santa Maria. Bairro: `)} target="_blank" rel="noopener" data-evento="whatsapp">Orçar {t.m} m³</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <p class="sobretitulo">Antes de encher</p>
          <h2>O que vai na caçamba</h2>
          <p>Caçamba de entulho recebe resíduo de obra. O resto tem destino próprio.</p>
        </div>
        <a class="link-seta" href="/blog/o-que-pode-e-o-que-nao-pode-na-cacamba-de-entulho/">Lista completa</a>
      </div>
      <div class="tres-colunas">
        <div class="coluna" style="--c:#15803d">
          <h3>Pode</h3>
          <p>Tijolo, bloco, concreto, reboco, telha cerâmica, piso, azulejo, louça, pedra, areia e terra.</p>
        </div>
        <div class="coluna" style="--c:#ca8a04">
          <h3>Consulte antes</h3>
          <p>Madeira, gesso, metal, vidro, poda de árvore e móveis velhos.</p>
        </div>
        <div class="coluna" style="--c:#dc2626">
          <h3>Não pode</h3>
          <p>Lixo doméstico, tinta, solvente, óleo, amianto, pneu, eletrônico, pilha e lâmpada.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap duo">
      <div>
        <p class="sobretitulo">Regras da prefeitura</p>
        <h2>O que Santa Maria exige de quem usa caçamba</h2>
        <ul class="lista-check">
          <li>Caçamba de no máximo 5 m³, sem entulho acima da borda. O excesso gera multa para quem contratou.</li>
          <li>Lixo doméstico misturado ao entulho é proibido, com multa para o contratante.</li>
          <li>A caçamba deve ter identificação da empresa, faixas reflexivas e a inscrição "proibido lixo doméstico".</li>
          <li>O transporte sai com Controle de Transporte de Resíduos (CTR) para área licenciada.</li>
          <li>Material de construção solto na rua: no máximo 6 horas.</li>
        </ul>
        <p class="fonte">Fontes: <a href={FONTES.decreto146} target="_blank" rel="noopener">Decreto Executivo nº 146/2009</a> e <a href={FONTES.codigoPosturas} target="_blank" rel="noopener">Lei Complementar nº 92/2012</a>, Câmara de Vereadores de Santa Maria.</p>
        <a class="link-seta" href="/blog/regras-para-cacamba-na-rua-em-santa-maria/">Resumo das regras</a>
      </div>
      <Img nome="entulho-de-tijolos" alt="Monte de tijolos e blocos de concreto quebrados, entulho típico de obra" sizes="(max-width: 860px) 100vw, 520px" />
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="wrap estreito">
      <p class="sobretitulo">Tele entulho em Santa Maria</p>
      <h2>Tele entulho, caçamba estacionária, contêiner: é tudo a mesma coisa</h2>
      <p>No Rio Grande do Sul, quem precisa tirar entulho de obra costuma procurar por <strong>tele entulho</strong>. Em outros lugares o mesmo serviço aparece como caçamba de entulho, caçamba estacionária, contêiner de entulho, disk entulho ou tele caçamba. Em todos os casos é a mesma solução: uma caixa metálica de 3 a 5 m³ que fica na frente da obra e depois é recolhida por um caminhão poliguindaste.</p>
      <p>O que muda de uma empresa para outra é o atendimento, o prazo e o cuidado com o destino do entulho. Em Santa Maria, o transporte precisa sair com o Controle de Transporte de Resíduos e ir para uma área licenciada pela Secretaria de Proteção Ambiental. Pergunte por isso no orçamento: é a garantia de que o entulho da sua obra não vai acabar num terreno baldio.</p>
      <p>Para pedir, mande pelo WhatsApp o endereço da obra, o bairro e o que vai ser descartado. Se não souber o tamanho, envie fotos do entulho e receba a indicação junto com o valor.</p>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <p class="sobretitulo">Onde atendemos</p>
          <h2>Bairros de Santa Maria</h2>
          <p>Peça tele entulho em qualquer bairro. Estes têm página com dicas de acesso e de obra:</p>
        </div>
        <a class="link-seta" href="/bairros/">Ver todos</a>
      </div>
      <ul class="chips">
        {BAIRROS.map((b) => <li><a href={`/bairros/${b.slug}/`}>{b.nome}</a></li>)}
      </ul>
      <h3 style="margin-top:2.5rem">Cidades vizinhas</h3>
      <p class="fonte" style="margin-bottom:1rem">Conforme a agenda da empresa parceira, com possível taxa de deslocamento.</p>
      <ul class="chips">
        {CIDADES.map((c) => <li><a href={`/cidades/${c.slug}/`}>{c.nome}</a></li>)}
      </ul>
    </div>
  </section>

  <MapaAtendimento />

  <section class="secao secao-areia">
    <div class="wrap estreito">
      <p class="sobretitulo">Dúvidas</p>
      <h2>Perguntas frequentes</h2>
      <Faq itens={FAQ_HOME} />
      <p style="margin-top:1.5rem"><a class="link-seta" href="/perguntas-frequentes/">Todas as perguntas</a></p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="secao">
      <div class="wrap">
        <div class="cabeca">
          <div>
            <p class="sobretitulo">Blog</p>
            <h2>Guias antes de pedir</h2>
          </div>
          <a class="link-seta" href="/blog/">Ver o blog</a>
        </div>
        <div class="grade grade-3 trilho">
          {posts.map((p) => (
            <article class="card card-img card-link">
              <Img nome={p.imagem} alt={p.imagemAlt} sizes="(max-width: 600px) 82vw, (max-width: 960px) 50vw, 360px" />
              <div class="card-corpo">
                <h3><a href={p.url}>{p.titulo}</a></h3>
                <p>{p.descricao}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <Cta />
</Base>
