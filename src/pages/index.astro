---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import CacambaArte from '../components/CacambaArte.astro';
import IconeWhats from '../components/IconeWhats.astro';
import { SITE, linkWhatsapp, FONTES } from '../config';
import { SERVICOS } from '../data/servicos';
import { BAIRROS, CIDADES } from '../data/locais';
import { FAQ_HOME } from '../data/faq';

const posts = Object.values(import.meta.glob<any>('./blog/*.md', { eager: true }))
  .map((p) => ({ url: p.url, ...p.frontmatter }))
  .sort((a, b) => (a.data < b.data ? 1 : -1))
  .slice(0, 3);

const base = new URL('/', Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${base}#servico`,
    name: 'Tele entulho e caçamba de entulho em Santa Maria',
    serviceType: 'Aluguel de caçamba de entulho',
    provider: { '@id': `${base}#organizacao` },
    areaServed: [
      { '@type': 'City', name: 'Santa Maria' },
      ...CIDADES.map((c) => ({ '@type': 'City', name: c.nome })),
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Serviços',
      itemListElement: SERVICOS.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.nome, url: new URL(`/servicos/${s.slug}/`, Astro.site).href },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_HOME.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  },
];

const passos = [
  { t: 'Chame no WhatsApp', d: 'Diga o endereço, o bairro e o que vai descartar. Foto do entulho ajuda.' },
  { t: 'Receba o orçamento', d: 'Tamanho indicado, valor, prazo de entrega e dias de permanência, antes de fechar.' },
  { t: 'A caçamba chega', d: 'Entregue no ponto combinado: dentro do terreno ou junto ao meio-fio.' },
  { t: 'Retirada ou troca', d: 'Encheu? Avise. A caçamba sai e o entulho vai para área licenciada.' },
];

const tamanhos = [
  { m: 3, uso: 'Banheiro, cozinha, muro pequeno, limpeza de pátio', carrinhos: 50, h: 36 },
  { m: 4, uso: 'Reforma de vários cômodos, troca de piso da casa', carrinhos: 65, h: 46 },
  { m: 5, uso: 'Demolição, telhado e obra nova. Máximo em Santa Maria', carrinhos: 80, h: 56 },
];
const wa = linkWhatsapp();
---
<Base
  title="Tele Entulho em Santa Maria RS | Caçamba de Entulho"
  description="Tele entulho em Santa Maria RS: aluguel de caçamba de entulho de 3 a 5 m³ para obra, reforma e limpeza, com descarte licenciado. Orçamento no WhatsApp."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-grade">
      <div>
        <p class="sobretitulo" style="color:#ffb68a">Santa Maria · RS</p>
        <h1>Tele entulho em Santa Maria: caçamba de entulho na porta da sua obra</h1>
        <p class="lead">Aluguel de caçamba de entulho em Santa Maria para reforma, construção e limpeza de terreno. Você manda o endereço pelo WhatsApp, recebe tamanho, valor e prazo, e o entulho sai da obra para uma área licenciada.</p>
        <div class="botoes">
          <a class="btn btn-whats" href={wa} target="_blank" rel="noopener" data-evento="whatsapp"><IconeWhats />Pedir caçamba no WhatsApp</a>
          <a class="btn btn-claro" href="/servicos/tamanhos-de-cacamba/">Ver tamanhos</a>
        </div>
        <ul class="selos">
          <li>Caçambas de 3 a 5 m³</li>
          <li>Destino licenciado com CTR</li>
          <li>Orçamento sem compromisso</li>
        </ul>
      </div>
      <CacambaArte class="hero-arte" />
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <p class="sobretitulo">Como funciona</p>
      <h2>Do pedido à retirada em quatro passos</h2>
      <div class="grade grade-4" style="margin-top:1.5rem">
        {passos.map((p, i) => (
          <div class="card">
            <div class="numero">0{i + 1}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="wrap">
      <p class="sobretitulo">Serviços</p>
      <h2>Caçamba de entulho em Santa Maria para cada tipo de obra</h2>
      <p class="estreito">O tele entulho resolve o que sobra da obra sem você precisar alugar caminhão, contratar carreto ou procurar onde descartar. A caçamba fica no local, você enche no seu ritmo e a retirada é agendada pelo WhatsApp.</p>
      <div class="grade grade-4" style="margin-top:1.5rem">
        {SERVICOS.map((s) => (
          <article class="card card-img">
            <Img nome={s.imagem} alt={s.imagemAlt} sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 280px" />
            <div class="card-corpo">
              <h3><a href={`/servicos/${s.slug}/`} style="color:inherit;text-decoration:none">{s.nome}</a></h3>
              <p>{s.curto}</p>
              <a class="mais" href={`/servicos/${s.slug}/`}>Saiba mais</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <p class="sobretitulo">Tamanhos</p>
      <h2>Qual caçamba pedir: 3, 4 ou 5 m³</h2>
      <p class="estreito">Um carrinho de mão de obra leva perto de 60 litros. Conte quantos carrinhos de entulho você tem e compare. Em Santa Maria, a caçamba de entulho pode ter no máximo 5 m³.</p>
      <div class="grade grade-3" style="margin-top:1.5rem">
        {tamanhos.map((t) => (
          <div class="card tamanho">
            <div class="m3">{t.m} <small>m³</small></div>
            <svg width="150" height="70" viewBox="0 0 150 70" aria-hidden="true">
              <path d={`M10 ${70 - t.h} H140 L128 66 H22 Z`} fill="#e8590c" />
              <rect x="22" y="64" width="106" height="6" rx="2" fill="#323f4b" />
            </svg>
            <p><strong>Cerca de {t.carrinhos} carrinhos de mão.</strong><br />{t.uso}.</p>
            <a class="mais" href={linkWhatsapp(`Olá! Vim pelo site e quero orçamento de caçamba de ${t.m} m³ em Santa Maria. Bairro: `)} target="_blank" rel="noopener" data-evento="whatsapp">Orçar caçamba de {t.m} m³</a>
          </div>
        ))}
      </div>
      <p style="margin-top:1.2rem"><a href="/servicos/tamanhos-de-cacamba/">Entenda a diferença entre volume e peso na escolha da caçamba</a></p>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="wrap grade grade-2" style="align-items:center;gap:2.5rem">
      <div>
        <p class="sobretitulo">Antes de encher</p>
        <h2>O que pode e o que não pode na caçamba</h2>
        <p>Entulho é resíduo de obra. A caçamba recebe material de construção e demolição; o resto tem destino próprio.</p>
        <ul class="lista-check">
          <li><strong>Pode:</strong> tijolo, bloco, concreto, reboco, telha cerâmica, piso, azulejo, louça, pedra, areia e terra.</li>
          <li><strong>Consulte:</strong> madeira, gesso, metal, vidro, poda e móveis.</li>
          <li><strong>Não pode:</strong> lixo doméstico, tinta, solvente, óleo, amianto, pneu, eletrônico, pilha e lâmpada.</li>
        </ul>
        <p><a href="/blog/o-que-pode-e-o-que-nao-pode-na-cacamba-de-entulho/">Lista completa do que pode e do que não pode</a></p>
      </div>
      <Img nome="entulho-de-tijolos" alt="Monte de tijolos e blocos de concreto quebrados, entulho típico de obra" sizes="(max-width: 620px) 100vw, 540px" />
    </div>
  </section>

  <section class="secao">
    <div class="wrap estreito">
      <p class="sobretitulo">Regras da prefeitura</p>
      <h2>O que Santa Maria exige de quem usa caçamba</h2>
      <p>Santa Maria tem regras próprias para caçambas e entulho, no Plano de Gerenciamento de Resíduos da Construção Civil (Decreto Executivo nº 146/2009) e no Código de Posturas (Lei Complementar nº 92/2012). As principais:</p>
      <ul class="lista-check">
        <li>Caçamba de no máximo 5 m³, sem entulho acima da borda. O excesso gera multa para quem contratou.</li>
        <li>Lixo doméstico misturado ao entulho é proibido, com multa para o contratante.</li>
        <li>A separação do material é responsabilidade de quem gera o entulho.</li>
        <li>A caçamba deve ter nome da empresa, telefone, licença de operação, faixas reflexivas e a inscrição "proibido lixo doméstico".</li>
        <li>O transporte sai com Controle de Transporte de Resíduos (CTR) e vai só para área licenciada.</li>
        <li>Material de construção solto na via: no máximo 6 horas.</li>
      </ul>
      <p class="fonte">Fontes: <a href={FONTES.decreto146} target="_blank" rel="noopener">Decreto Executivo nº 146/2009</a> e <a href={FONTES.codigoPosturas} target="_blank" rel="noopener">Lei Complementar nº 92/2012</a>, Câmara de Vereadores de Santa Maria. <a href="/blog/regras-para-cacamba-na-rua-em-santa-maria/">Leia o resumo das regras</a>.</p>
    </div>
  </section>

  <section class="secao secao-grafite">
    <div class="wrap">
      <h2>Bairros de Santa Maria com página própria</h2>
      <p>Peça tele entulho em qualquer bairro da cidade. Estes têm dicas específicas de acesso e de obra:</p>
      <ul class="chips" style="margin:1.2rem 0 2rem">
        {BAIRROS.map((b) => <li><a href={`/bairros/${b.slug}/`}>{b.nome}</a></li>)}
      </ul>
      <h3>Cidades vizinhas</h3>
      <p>Atendimento conforme a agenda da empresa parceira, com possível taxa de deslocamento:</p>
      <ul class="chips" style="margin-top:1rem">
        {CIDADES.map((c) => <li><a href={`/cidades/${c.slug}/`}>{c.nome}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="wrap estreito">
      <p class="sobretitulo">Dúvidas</p>
      <h2>Perguntas frequentes sobre caçamba de entulho</h2>
      <Faq itens={FAQ_HOME} />
      <p style="margin-top:1rem"><a href="/perguntas-frequentes/">Ver todas as perguntas</a></p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="secao secao-areia">
      <div class="wrap">
        <p class="sobretitulo">Blog</p>
        <h2>Guias para quem vai pedir caçamba</h2>
        <div class="grade grade-3" style="margin-top:1.5rem">
          {posts.map((p) => (
            <article class="card card-img">
              <Img nome={p.imagem} alt={p.imagemAlt} sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 370px" />
              <div class="card-corpo">
                <h3><a href={p.url} style="color:inherit;text-decoration:none">{p.titulo}</a></h3>
                <p>{p.descricao}</p>
                <a class="mais" href={p.url}>Ler guia</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <Cta />
</Base>
