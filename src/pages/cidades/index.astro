---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Migalhas from '../../components/Migalhas.astro';
import { CIDADES } from '../../data/locais';
const migalhas = [{ nome: 'Cidades vizinhas' }];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Caçamba de entulho nas cidades vizinhas de Santa Maria',
  itemListElement: CIDADES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.nome, url: new URL(`/cidades/${c.slug}/`, Astro.site).href })),
};
---
<Base
  title="Caçamba de Entulho na Região de Santa Maria RS"
  description="Caçamba de entulho em Itaara, Silveira Martins, São Pedro do Sul, Restinga Sêca e Formigueiro, com atendimento a partir de Santa Maria RS."
  schema={schema}
  migalhas={migalhas}
>
  <header class="pagina-topo">
    <div class="wrap">
      <Migalhas itens={migalhas} />
      <h1>Caçamba de entulho nas cidades vizinhas de Santa Maria</h1>
      <p class="lead estreito">A base é Santa Maria. Para obras em municípios próximos, a caçamba pode ir até você conforme a agenda da empresa parceira, normalmente com taxa de deslocamento. Confirme sempre pelo WhatsApp antes de marcar a obra.</p>
    </div>
  </header>
  <section class="secao">
    <div class="wrap grade grade-3">
      {CIDADES.map((c) => (
        <article class="card">
          <h2 style="font-size:1.25rem"><a href={`/cidades/${c.slug}/`} style="color:inherit;text-decoration:none">{c.nome}</a></h2>
          <p>{c.descricao}</p>
          <a class="mais" href={`/cidades/${c.slug}/`}>Caçamba {c.prep} {c.nome}</a>
        </article>
      ))}
    </div>
  </section>
  <Cta />
</Base>
